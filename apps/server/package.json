{
  "name": "@infra/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma generate && tsx --conditions=development src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy && prisma generate",
    "agent:register": "tsx --conditions=development src/cli/register-agent.ts"
  },
  "dependencies": {
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.2",
    "@infra/protocol": "workspace:*",
    "@infra/schemas": "workspace:*",
    "@infra/types": "workspace:*",
    "@infra/utils": "workspace:*",
    "@prisma/client": "^6.5.0",
    "fastify": "^5.2.1",
    "fastify-type-provider-zod": "^4.0.2",
    "prisma": "^6.5.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
